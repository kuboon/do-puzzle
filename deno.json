{
  "workspace": [
    "./web/client",
    "./web/server",
    "./web/tests"
  ],
  "tasks": {
    "dev": "deno task --cwd web/server dev",
    "build": "deno task --cwd web/server build",
    "test": "deno test -P --ignore=web/tests",
    "test:browser": "deno task --cwd web/tests test",
    "check": "deno task --cwd web/client check && deno task --cwd web/server check && deno lint && deno fmt --check"
  },
  "permissions": {
    "default": {
      "read": true,
      "env": true,
      "net": [
        "localhost",
        "127.0.0.1"
      ],
      "import": true
    }
  },
  "test": {
    "permissions": "default"
  },
  "nodeModulesDir": "auto",
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": [
      "jsr:@kuboon/*",
      "jsr:@remix-kbn/*",
      "npm:@remix-run/*"
    ]
  },
  "unstable": [
    "bundle"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@remix-run/component"
  },
  "imports": {
    "@kuboon/bgm": "jsr:@kuboon/bgm@^0.1.0",
    "@kuboon/md": "jsr:@kuboon/md@^0.7.0",
    "@lightpanda/browser": "npm:@lightpanda/browser@^1.2.0",
    "@remix-kbn/assets-deno": "jsr:@remix-kbn/assets-deno@^0.9.0",
    "@remix-kbn/ssg": "jsr:@remix-kbn/ssg@^0.13.0",
    "@remix-run/component": "npm:@remix-run/component@^1.0.0",
    "@remix-run/fetch-router": "npm:@remix-run/fetch-router@^1.0.0",
    "@remix-run/render-middleware": "npm:@remix-run/render-middleware@^1.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "canvaskit-wasm": "npm:canvaskit-wasm@^0.40.0",
    "puppeteer-core": "npm:puppeteer-core@^23.11.1"
  },
  "allowScripts": {
    "allow": [
      "npm:@lightpanda/browser@1.2.0"
    ]
  },
  "fmt": {
    "exclude": [
      "web/dist",
      "node_modules"
    ]
  },
  "lint": {
    "exclude": [
      "web/dist",
      "node_modules"
    ]
  }
}
